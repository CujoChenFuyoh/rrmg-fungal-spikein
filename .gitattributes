# Linux workflow: keep repository text as LF, including Windows checkouts.
* text=auto eol=lf
*.sh text eol=lf
*.R text eol=lf
*.r text eol=lf
*.pbs text eol=lf
*.ps1 text eol=lf
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.tsv text eol=lf
*.toml text eol=lf
*.txt text eol=lf
# Binary artifacts must never have their bytes normalized.
*.png binary
*.jpg binary
*.pdf binary
*.gz binary
*.zip binary
*.whl binary
