#!/usr/bin/env bash
# Legacy convenience example, not used by the core runner.
# Adapt resource directives to your scheduler; prefer examples/pbs*.pbs.
#PBS -N rrmg_target_merge
#PBS -l walltime=08:00:00
#PBS -l select=1:ncpus=8:mem=32gb
#PBS -j oe
#PBS -S /bin/bash

set -euo pipefail
export RRMG_CONFIG="${RRMG_CONFIG:-${PBS_O_WORKDIR:-$PWD}/rrmg_config.sh}"
source "$RRMG_CONFIG"
# Optional compatibility with older configs; otherwise activate before calling.
if [[ -n "${CONDA_SH:-}" ]]; then
  source "$CONDA_SH"
  conda activate "${RRMG_CONDA_ENV:-fungamr_meta}"
fi
ROW="${PBS_ARRAY_INDEX:-${PBS_ARRAYID:-${RRMG_ROW_INDEX:-}}}"
[[ "$ROW" =~ ^[1-9][0-9]*$ ]] || { echo '[ERROR] Set a single original row index' >&2; exit 1; }
exec bash "$PIPELINE_DIR/rrmg_submit.sh" step2 "$ROW" --jobs 1
