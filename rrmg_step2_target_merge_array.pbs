#!/bin/bash
# PBS wrapper for one permutation-plan row. Site paths and runtime parameters
# are read from rrmg_config.sh. Submit through rrmg_submit.sh.
#PBS -N rrmg_target_merge
#PBS -l walltime=08:00:00
#PBS -l select=1:ncpus=8:mem=32gb
#PBS -j oe
#PBS -S /bin/bash

set -euo pipefail

CONFIG="${RRMG_CONFIG:-${PBS_O_WORKDIR:-$PWD}/rrmg_config.sh}"
[[ -r "$CONFIG" ]] || { echo "[ERROR] Configuration not found: $CONFIG" >&2; exit 1; }
# shellcheck disable=SC1090
source "$CONFIG"

: "${WD:?Set WD in $CONFIG}"
: "${PIPELINE_DIR:?Set PIPELINE_DIR in $CONFIG}"
: "${CONDA_SH:?Set CONDA_SH in $CONFIG}"
: "${RRMG_CONDA_ENV:?Set RRMG_CONDA_ENV in $CONFIG}"
: "${BBMAP_DIR:?Set BBMAP_DIR in $CONFIG}"
: "${RANDOMREADSMG_SH:?Set RANDOMREADSMG_SH in $CONFIG}"
: "${JAVA_HOME:?Set JAVA_HOME in $CONFIG}"
: "${JAVA_BIN:?Set JAVA_BIN in $CONFIG}"

PLAN="${PLAN:-input/rrmg/rrmg_permutation_plan.tsv}"
BACKGROUND_INDEX="${BACKGROUND_INDEX:-temp/rrmg_background/background_index.tsv}"
ROW_INDEX="${PBS_ARRAY_INDEX:-${RRMG_ROW_INDEX:-}}"
[[ "$ROW_INDEX" =~ ^[0-9]+$ ]] || { echo "[ERROR] Missing/invalid array row index: ${ROW_INDEX:-unset}" >&2; exit 1; }

cd "$WD"
LOG_DIR="${RRMG_LOG_DIR:-logs/pbs}"
mkdir -p "$LOG_DIR"

exec > >(tee -a "$LOG_DIR/step2_target_merge_${PBS_JOBID:-manual}.${PBS_ARRAY_INDEX:-manual}.log") 2>&1

echo "++++++++++++++++++++++++++++++++++++++++"
echo "Step 2: make target reads and merge metagenome"
echo "Host            : $(hostname)"
echo "PBS_JOBID       : ${PBS_JOBID:-NA}"
echo "PBS_ARRAY_INDEX : ${PBS_ARRAY_INDEX:-NA}"
echo "ROW_INDEX       : $ROW_INDEX"
echo "CONFIG          : $CONFIG"
echo "WD              : $WD"
echo "Start time      : $(date)"
echo "++++++++++++++++++++++++++++++++++++++++"

source "$CONDA_SH"
export CONDA_SH
export RRMG_CONDA_ENV
export BBMAP_DIR
export RANDOMREADSMG_SH
export JAVA_HOME
export JAVA_BIN
export PATH="$BBMAP_DIR:$JAVA_HOME/bin:$PATH"
conda activate "$RRMG_CONDA_ENV"

[[ -s "$PLAN" ]] || { echo "[ERROR] Missing plan: $PLAN"; exit 1; }
[[ -s "$BACKGROUND_INDEX" ]] || { echo "[ERROR] Missing background index: $BACKGROUND_INDEX"; exit 1; }
[[ -s "$RANDOMREADSMG_SH" ]] || { echo "[ERROR] Missing RANDOMREADSMG_SH: $RANDOMREADSMG_SH"; exit 1; }
[[ -x "$JAVA_BIN" ]] || { echo "[ERROR] JAVA_BIN is not executable: $JAVA_BIN"; exit 1; }
STEP_SCRIPT="${PIPELINE_DIR}/rrmg_step2_make_target_and_merge.sh"
[[ -s "$STEP_SCRIPT" ]] || { echo "[ERROR] Missing script: $STEP_SCRIPT"; exit 1; }

echo "[INFO] PLAN              : $PLAN"
echo "[INFO] BACKGROUND_INDEX  : $BACKGROUND_INDEX"
echo "[INFO] RANDOMREADSMG_SH  : $RANDOMREADSMG_SH"
echo "[INFO] JAVA_BIN          : $JAVA_BIN"
"$JAVA_BIN" -version

EXTRA_ARGS=()
[[ "${STEP2_KEEP_TARGET_READS:-1}" -eq 1 ]] && EXTRA_ARGS+=(--keep-target-reads)
[[ "${RRMG_FORCE_OVERRIDE:-${STEP2_FORCE:-0}}" -eq 1 ]] && EXTRA_ARGS+=(--force)

bash "$STEP_SCRIPT" \
  "$PLAN" \
  "$ROW_INDEX" \
  -w "$WD" \
  --background-index "$BACKGROUND_INDEX" \
  "${EXTRA_ARGS[@]}"

echo "++++++++++++++++++++++++++++++++++++++++"
echo "Step 2 done: $(date)"
echo "[DONE] ROW_INDEX=${ROW_INDEX}"
echo "++++++++++++++++++++++++++++++++++++++++"
