#!/bin/bash
# EXAMPLE ONLY: edit paths/resources and submit the row range explicitly.
# PBS Pro: qsub -J 1-100 examples/pbs_array.pbs
# Torque:  qsub -t 1-100 examples/pbs_array.pbs (only if arrays are supported)
#PBS -N rrmg_array_example
#PBS -l select=1:ncpus=4:mem=24gb
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -S /bin/bash

set -euo pipefail
source /path/to/miniconda3/etc/profile.d/conda.sh
conda activate fungamr_meta
export RRMG_CONFIG=/path/to/SpikeIN/rrmg_config.sh
cd /path/to/rrmg-fungal-spikein

# Optional on PBS systems needing explicit Java selection (after activation):
# export JAVA_BIN="$(readlink -f "$CONDA_PREFIX/bin/java")"
# export JAVA_HOME="$(dirname "$(dirname "$JAVA_BIN")")"
# export PATH="$JAVA_HOME/bin:$PATH"
# java -version
# Leave Java overrides in the config empty when using these exports.

ROW="${PBS_ARRAY_INDEX:-${PBS_ARRAYID:-}}"
[[ "$ROW" =~ ^[1-9][0-9]*$ ]] || { echo '[ERROR] Array index is unset/invalid' >&2; exit 1; }
# One array task = one original plan ID. NEVER pass "1-$ROW" here.
RUN_ARGS=(-t "${RRMG_THREADS:-1}" --jobs 1)
[[ -n "${RRMG_MEMORY_GB:-}" ]] && RUN_ARGS+=(-m "$RRMG_MEMORY_GB")
bash ./rrmg_submit.sh "${RRMG_STAGE:-step2}" "$ROW" "${RUN_ARGS[@]}"
